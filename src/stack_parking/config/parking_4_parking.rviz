Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Alpha: 0.35
      Cell Size: 0.5
      Color: 120; 130; 140
      Plane: XY
      Plane Cell Count: 20
    - Class: rviz_default_plugins/PointCloud2
      Name: Frozen parking map
      Enabled: true
      Topic:
        Value: /parking/local_map
        Reliability Policy: Reliable
      Style: Points
      Size (Pixels): 2
      Color Transformer: FlatColor
      Color: 110; 110; 110
      Alpha: 0.45
      Position Transformer: XYZ
    - Class: rviz_default_plugins/Path
      Name: Full parking path
      Enabled: true
      Topic:
        Value: /parking/reference_path
        Reliability Policy: Reliable
      Line Style: Lines
      Line Width: 0.06
      Color: 40; 220; 90
    - Class: rviz_default_plugins/Path
      Name: Active gear segment
      Enabled: true
      Topic:
        Value: /parking/active_path
        Reliability Policy: Reliable
      Line Style: Lines
      Line Width: 0.10
      Color: 255; 170; 0
    - Class: rviz_default_plugins/MarkerArray
      Name: Preview space and mission state
      Enabled: true
      Topic:
        Value: /parking/debug_markers
        Reliability Policy: Reliable
      Namespaces: {}
    - Class: rviz_default_plugins/Pose
      Name: Vehicle pose
      Enabled: true
      Topic:
        Value: /parking/slam_pose
        Reliability Policy: Reliable
      Shape: Axes
    - Class: rviz_default_plugins/Marker
      Name: Stage and x y yaw
      Enabled: true
      Topic:
        Value: /parking/slam_pose_text
        Reliability Policy: Reliable
  Global Options:
    Background Color: 25; 28; 32
    Fixed Frame: parking_map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/FocusCamera
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Parking top view
      Scale: 130
      Target Frame: <Fixed Frame>
      X: 0
      Y: 0
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1500
