Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Alpha: 0.35
      Cell Size: 0.5
      Color: 120; 130; 140
      Plane: XY
      Plane Cell Count: 20
    - Class: rviz_default_plugins/PointCloud2
      Name: Accumulated endpoint map (no fictitious rays)
      Enabled: true
      Topic:
        Value: /parking/local_map
        Reliability Policy: Reliable
      Style: Points
      Size (Pixels): 4
      Color Transformer: FlatColor
      Color: 235; 235; 235
      Position Transformer: XYZ
    - Class: rviz_default_plugins/MarkerArray
      Name: Detected space, stage and goal
      Enabled: true
      Topic:
        Value: /parking/debug_markers
        Reliability Policy: Reliable
      Namespaces: {}
    - Class: rviz_default_plugins/Pose
      Name: Vehicle pose
      Enabled: true
      Topic:
        Value: /parking/slam_pose
        Reliability Policy: Reliable
      Shape: Axes
  Global Options:
    Background Color: 25; 28; 32
    Fixed Frame: parking_map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/FocusCamera
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Mapping top view
      Scale: 130
      Target Frame: <Fixed Frame>
      X: 0
      Y: 0
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1500
