Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Alpha: 0.35
      Cell Size: 0.5
      Color: 120; 130; 140
      Plane: XY
      Plane Cell Count: 20
    - Class: rviz_default_plugins/PointCloud2
      Name: ICP registered current scan
      Enabled: true
      Topic:
        Value: /parking/slam_scan
        Reliability Policy: Reliable
      Style: Points
      Size (Pixels): 4
      Color Transformer: FlatColor
      Color: 0; 230; 255
      Position Transformer: XYZ
    - Class: rviz_default_plugins/PointCloud2
      Name: ICP local map context
      Enabled: true
      Topic:
        Value: /parking/local_map
        Reliability Policy: Reliable
      Style: Points
      Size (Pixels): 2
      Color Transformer: FlatColor
      Color: 120; 120; 120
      Alpha: 0.45
      Position Transformer: XYZ
    - Class: rviz_default_plugins/Pose
      Name: ICP vehicle pose
      Enabled: true
      Topic:
        Value: /parking/slam_pose
        Reliability Policy: Reliable
      Shape: Axes
      Axes Length: 0.6
      Axes Radius: 0.05
    - Class: rviz_default_plugins/Marker
      Name: SLAM x y yaw
      Enabled: true
      Topic:
        Value: /parking/slam_pose_text
        Reliability Policy: Reliable
  Global Options:
    Background Color: 25; 28; 32
    Fixed Frame: parking_map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/FocusCamera
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: SLAM top view
      Scale: 130
      Target Frame: <Fixed Frame>
      X: 0
      Y: 0
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1500
