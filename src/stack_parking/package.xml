<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>stack_parking</name>
  <version>0.1.0</version>
  <description>주차공간 인식·로컬맵·주차 경로 + MPC/Vehicle MGM(dSPACE) — 담당: 손상민</description>
  <maintainer email="kyg100800@gmail.com">손상민</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>fma_interfaces</depend>
  <depend>diagnostic_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs_py</depend>
  <depend>visualization_msgs</depend>
  <depend>laser_geometry</depend>
  <exec_depend>multi_lidar_fusion</exec_depend>
  <exec_depend>lidar_fusion_v2</exec_depend>

  <!-- tools/lidar_fov.py · tools/lidar_overlap.py 가 쓰는 것 -->
  <depend>sensor_msgs</depend>
  <depend>python3-numpy</depend>

  <!-- ydlidar_ros2_driver 는 의도적으로 선언하지 않는다. main 에 없는 패키지라
       선언하면 rosdep/빌드가 깨진다. launch/dual_lidar_test.launch.py 는 실행
       시점에 드라이버 워크스페이스(예: ~/ydlidar_ros2_ws)를 오버레이로 소스해
       쓴다 — 시험용 launch 이므로 빌드 의존이 아니다. -->

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
