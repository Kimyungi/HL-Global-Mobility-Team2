<?xml version="1.0"?>
<package format="3">
  <name>stack_avoid_v2</name>
  <version>0.1.0</version>
  <description>Bounded vehicle-motion search in an observed S-course corridor.</description>
  <maintainer email="kyg100800@gmail.com">FMA</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>fma_interfaces</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>rcl_interfaces</depend>
  <depend>std_msgs</depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>lidar_fusion_v2</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
