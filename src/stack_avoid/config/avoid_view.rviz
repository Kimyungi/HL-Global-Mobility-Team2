Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: ~
      Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 24
      Color: 120; 120; 120
      Line Style:
        Value: Lines
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Show Axes: true
      Show Arrows: false
      Marker Scale: 0.6
    - Class: rviz_default_plugins/LaserScan
      Name: scan_all (전체 360)
      Enabled: true
      Topic:
        Value: /scan
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Style: Points
      Size (Pixels): 3
      Color Transformer: FlatColor
      Color: 130; 130; 130
    - Class: rviz_default_plugins/LaserScan
      Name: scan_front (코드가 보는 앞 180)
      Enabled: true
      Topic:
        Value: /scan_front
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Style: Spheres
      Size (m): 0.06
      Color Transformer: FlatColor
      Color: 255; 64; 64
    - Class: rviz_default_plugins/Axes
      Name: laser_frame (LiDAR 원점)
      Enabled: true
      Reference Frame: laser_frame
      Length: 0.6
      Radius: 0.02
    - Class: rviz_default_plugins/Axes
      Name: base_link (후축·차량전방=빨강X)
      Enabled: true
      Reference Frame: base_link
      Length: 0.8
      Radius: 0.03
  Global Options:
    Fixed Frame: laser_frame
    Background Color: 40; 44; 48
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: TopDown
      Scale: 110
      X: 0
      Y: 0
      Angle: 0
      Target Frame: laser_frame
    Saved: ~
Window Geometry:
  Height: 820
  Width: 1240
  Displays:
    collapsed: false
