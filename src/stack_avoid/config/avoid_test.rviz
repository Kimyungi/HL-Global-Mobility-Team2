Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: true
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: base_link
    Frame Rate: 30
    Background Color: 24; 30; 40
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.5
      Plane Cell Count: 20
      Color: 90; 100; 110
      Reference Frame: base_link
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Show Axes: true
      Marker Scale: 0.4
    - Class: rviz_default_plugins/LaserScan
      Name: ScanFront180
      Enabled: true
      Topic:
        Value: /scan_front
        Depth: 5
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Style: Points
      Size (Pixels): 5
      Color: 255; 90; 90
      Color Transformer: FlatColor
    - Class: rviz_default_plugins/LaserScan
      Name: ScanFull360(off)
      Enabled: false
      Topic:
        Value: /scan
        Depth: 5
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Style: Points
      Size (Pixels): 2
      Color: 110; 110; 110
      Color Transformer: FlatColor
    - Class: rviz_default_plugins/MarkerArray
      Name: AvoidMarkers
      Enabled: true
      Topic:
        Value: /avoid_markers
        Depth: 10
        Reliability Policy: Reliable
        Durability Policy: Volatile
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: TopDown
      Target Frame: base_link
      Scale: 130
      Angle: 0
      X: 1.0
      Y: 0
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1400
  Displays:
    collapsed: false
