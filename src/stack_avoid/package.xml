<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>stack_avoid</name>
  <version>0.1.0</version>
  <description>장애물 인지, 회피 가능 판정 재료(TTC·측방), 회피 경로 — 담당: 이기돈</description>
  <maintainer email="kyg100800@gmail.com">이기돈</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>fma_interfaces</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>rcl_interfaces</depend>
  <depend>visualization_msgs</depend>
  <exec_depend>python3-numpy</exec_depend>
  <!-- avoid_estop_joint.launch.py 가 stack_estop_node 를 함께 띄운다 (ⓐⓑⓒ 경계 시험) -->
  <exec_depend>stack_estop</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
