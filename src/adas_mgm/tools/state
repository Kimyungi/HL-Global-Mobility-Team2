#!/usr/bin/env python3
"""주행 스테이트 실시간 표시 (`ros2 run adas_mgm state`).

/adas/target_ref를 구독해 스테이트·v_ref·첫 ref point를 1초마다 출력한다.
"""
import time

import rclpy
from rclpy.node import Node
from fma_interfaces.msg import TargetRef

NAMES = {0: 'LANE(차선)', 1: 'WAYPOINT(GPS)', 2: 'AVOID(회피)', 3: 'PARKING(주차)'}


def main():
    rclpy.init()
    node = Node('state_watch')
    last = {}
    node.create_subscription(TargetRef, '/adas/target_ref',
                             lambda m: last.update(m=m), 1)
    print('스테이트 감시 중 (Ctrl+C 종료)', flush=True)
    prev_print = 0.0
    try:
        while rclpy.ok():
            rclpy.spin_once(node, timeout_sec=0.2)
            now = time.monotonic()
            if 'm' in last and now - prev_print >= 1.0:
                m = last['m']
                y0 = m.ref_points[0].y if m.ref_points else 0.0
                print(f"{NAMES.get(m.state, m.state):14s}  v_ref {m.v_ref:.2f} m/s"
                      f"  조향목표 y {y0:+.2f} m", flush=True)
                prev_print = now
    except KeyboardInterrupt:
        pass
    node.destroy_node()
    rclpy.shutdown()


if __name__ == '__main__':
    main()
