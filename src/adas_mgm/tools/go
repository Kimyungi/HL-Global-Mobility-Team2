#!/usr/bin/env python3
"""출발 인가: v2는 라이다 정상 수신 AND GPS FIXED(4).

v2의 카메라 영상은 마지막 미션에 사용하며 출발 준비를 대신하지 않는다.
과거 프로파일에서는 MGM 상태가 알리는 영상 수신/GPS 준비 중
하나와 필수 라이다 입력이 모두 준비되면 인가하고, 조향 경로·E-stop·CAN·미션 조건은 MGM이 별도로 적용한다.
stop 뒤 go는 중지를 해제하고 재인가한다. GPS 상주 서비스는 건드리지 않는다.
"""
import argparse
import sys
import time

import rclpy
from rclpy.node import Node
from std_msgs.msg import Bool
from fma_interfaces.msg import MgmState, TrafficStop
from start_readiness import readiness


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--timeout', type=float, default=8.)
    parser.add_argument('--skip-gps', action='store_true', help='과거 프로파일 전용: 카메라만으로 준비 판단 (v2 출발 불가)')
    parser.add_argument('--skip-lane', action='store_true', help='GPS만으로 준비 판단')
    parser.add_argument('--skip-avoid', action='store_true', help='호환 옵션: 라이다 필수 검사는 생략하지 않음')
    parser.add_argument('--require-traffic', action='store_true', help='신호등 heartbeat를 추가로 요구')
    parser.add_argument('--force', action='store_true', help='CLI 점검 생략; MGM의 준비/제어 게이트는 유지')
    argv = sys.argv[1:]
    args = parser.parse_args(argv[:argv.index('--ros-args')] if '--ros-args' in argv else argv)
    rclpy.init()
    node = Node('operator_go')
    latest = {}
    subscriptions = [
        node.create_subscription(MgmState, '/adas/mgm_state', lambda m: latest.__setitem__('state', m), 1),
        node.create_subscription(TrafficStop, '/perception/traffic_stop', lambda m: latest.__setitem__('traffic', m), 1),
    ]
    pub = node.create_publisher(Bool, '/operator/go', 1)
    try:
        deadline = time.monotonic()+args.timeout
        result = (False, False, False, False, False)
        while time.monotonic() < deadline:
            rclpy.spin_once(node, timeout_sec=.1)
            result = readiness(latest, node.get_clock().now().nanoseconds,
                               skip_gps=args.skip_gps, skip_camera=args.skip_lane,
                               require_traffic=args.require_traffic)
            if (result[0] or args.force) and pub.get_subscription_count():
                break
        print(f'카메라 영상={result[1]} | GPS FIXED={result[2]} | MGM={result[3]}')
        state = latest.get('state')
        print(f'라이다 정상={bool(state and state.lidar_ready)} | 미수신/무효={list(state.lidar_missing_topics) if state else ["MGM 미수신"]}')
        if not result[0] and not args.force:
            navigation = 'GPS FIXED' if state and state.revised_v2 else '(카메라 영상 OR GPS FIXED)'
            print(f'출발 대기: 라이다 정상 수신 AND {navigation}가 필요합니다.')
            return 1
        # Repetition handles discovery loss; success is the MGM acknowledgment.
        sent_after_ns = node.get_clock().now().nanoseconds
        deadline = time.monotonic()+2.
        while time.monotonic() < deadline:
            pub.publish(Bool(data=True))
            rclpy.spin_once(node, timeout_sec=.1)
            state = latest.get('state')
            if (state is not None and state.header.stamp.sec*1_000_000_000+state.header.stamp.nanosec >= sent_after_ns
                    and state.go_authorized and state.start_ready and readiness(latest, node.get_clock().now().nanoseconds)[3]):
                print('출발 인가 완료 (MGM 확인). 실제 이동은 선택된 경로와 제어 조건에 따릅니다.')
                return 0
        print('MGM 출발 인가 확인 실패 — scripts/v2 state로 준비 상태를 확인하세요.')
        return 1
    finally:
        node.destroy_node()
        rclpy.try_shutdown()


if __name__ == '__main__':
    sys.exit(main())
