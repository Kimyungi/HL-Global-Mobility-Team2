#!/usr/bin/env python3
"""출발 전 점검 + 출발 인가 (`ros2 run adas_mgm go`).

실차 통합 launch(REAL_VEHICLE_lane_gps_can)는 wait_go:=true로 떠서 인가 전까지
정지 대기한다 (2026-08-11 — launch 직후 바로 출발해 점검이 불가능하던 문제).
이 스크립트는 점검 5종을 통과해야 /operator/go 를 발행한다:

  ① gps_path 수신 + RTK FIXED(fix_quality=4)   ② lane_path 수신 (차선 카메라)
  ③ scan 수신 (돌발정지 라이다)                 ④ target_ref 수신 (MGM 체인)
  ⑤ avoid 수신 (회피 인지 — 2026-08-12 통합)

신호등 통합 런북에서는 `--require-traffic`을 붙여 ⑥ traffic_stop 수신도 필수로 한다.

개별 점검을 건너뛰려면: --skip-gps (실내 시험), --skip-lane (GPS 단독 시험 등), --skip-avoid,
--force (전부 무시하고 인가).

토픽 remap 이 필요하면 `--ros-args` 뒤에 붙인다 (MBD bench 는 MGM 출력이
/bench/adas/target_ref 로 격리되므로 ④ 점검에 remap 이 필요하다):

  ros2 run adas_mgm go --ros-args -r /adas/target_ref:=/bench/adas/target_ref
"""
import argparse
import sys
import time

import rclpy
from rclpy.node import Node
from rclpy.qos import qos_profile_sensor_data
from std_msgs.msg import Bool
from sensor_msgs.msg import LaserScan
from fma_interfaces.msg import AvoidStatus, GpsPath, LanePath, TargetRef, TrafficStop

QUALITY_NAMES = {0: 'INVALID', 1: 'GPS', 2: 'DGPS', 4: 'RTK FIXED', 5: 'RTK FLOAT'}


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument('--skip-gps', action='store_true', help='GPS/RTK 점검 생략 (실내 시험)')
    ap.add_argument('--skip-lane', action='store_true', help='차선 점검 생략 (GPS 단독 시험)')
    ap.add_argument('--skip-avoid', action='store_true', help='회피 점검 생략 (구 launch 등)')
    ap.add_argument('--require-traffic', action='store_true',
                    help='신호등 인지 traffic_stop 수신을 출발 필수 조건으로 검사')
    ap.add_argument('--force', action='store_true', help='점검 전부 생략하고 인가 (비상용)')
    ap.add_argument('--timeout', type=float, default=8.0, help='토픽별 대기 시간 [s]')
    # `--ros-args` 뒤는 argparse 가 아니라 rclpy 몫이다. 안 잘라 내면
    # "unrecognized arguments" 로 죽어서 **remap 을 쓸 수 없다** — MBD bench
    # 시험은 MGM 출력이 /bench/adas/target_ref 로 격리되므로 remap 이 필수다.
    # rclpy.init() 은 sys.argv 를 그대로 읽으므로 여기서 잘라도 remap 은 먹는다.
    #
    #   ros2 run adas_mgm go --ros-args -r /adas/target_ref:=/bench/adas/target_ref
    argv = sys.argv[1:]
    if '--ros-args' in argv:
        argv = argv[:argv.index('--ros-args')]
    args = ap.parse_args(argv)

    rclpy.init()
    node = Node('operator_go')
    latest = {}
    node.create_subscription(GpsPath, '/perception/gps_path', lambda m: latest.__setitem__('gps', m), 1)
    node.create_subscription(LanePath, '/perception/lane_path', lambda m: latest.__setitem__('lane', m), 1)
    # /scan은 best-effort 발행 — reliable 기본 QoS로 구독하면 비호환으로 미수신
    # (2026-08-11 현장에서 오탐 FAIL 실측)
    node.create_subscription(LaserScan, '/scan', lambda m: latest.__setitem__('scan', m),
                             qos_profile_sensor_data)
    node.create_subscription(TargetRef, '/adas/target_ref', lambda m: latest.__setitem__('ref', m), 1)
    node.create_subscription(AvoidStatus, '/perception/avoid', lambda m: latest.__setitem__('avoid', m), 1)
    node.create_subscription(TrafficStop, '/perception/traffic_stop',
                             lambda m: latest.__setitem__('traffic', m), 1)

    if not args.force:
        need = ['scan', 'ref'] + ([] if args.skip_gps else ['gps']) \
            + ([] if args.skip_lane else ['lane']) \
            + ([] if args.skip_avoid else ['avoid']) \
            + (['traffic'] if args.require_traffic else [])
        deadline = time.monotonic() + args.timeout
        while time.monotonic() < deadline and not all(k in latest for k in need):
            rclpy.spin_once(node, timeout_sec=0.2)

        ok = True
        for key, label in [('gps', 'GPS 경로'), ('lane', '차선 경로'),
                           ('scan', '라이다'), ('ref', 'MGM target_ref'),
                           ('avoid', '회피 인지'), ('traffic', '신호등 인지')]:
            if key == 'gps' and args.skip_gps:
                print('  [skip] GPS 경로/RTK (--skip-gps)')
                continue
            if key == 'lane' and args.skip_lane:
                print('  [skip] 차선 경로 (--skip-lane)')
                continue
            if key == 'avoid' and args.skip_avoid:
                print('  [skip] 회피 인지 (--skip-avoid)')
                continue
            if key == 'traffic' and not args.require_traffic:
                print('  [skip] 신호등 인지 (--require-traffic 미지정)')
                continue
            if key in latest:
                print(f'  [OK]   {label}')
            else:
                print(f'  [FAIL] {label} — 미수신 ({args.timeout:.0f}s 대기)')
                ok = False
        if 'gps' in latest and not args.skip_gps:
            q = latest['gps'].fix_quality
            if q == 4:
                print(f'  [OK]   RTK: {QUALITY_NAMES.get(q, q)}')
            else:
                print(f'  [FAIL] RTK: {QUALITY_NAMES.get(q, q)} — FIXED(4) 아님. 잠시 후 재시도')
                ok = False
        if 'lane' in latest and not args.skip_lane:
            print(f'         차선 confidence: {latest["lane"].confidence:.2f}')
        if not ok:
            print('\n점검 불합격 — 출발 인가 안 함. (강행: --force)')
            node.destroy_node()
            rclpy.shutdown()
            sys.exit(1)
    else:
        print('  [force] 점검 생략')

    pub = node.create_publisher(Bool, '/operator/go', 1)
    time.sleep(0.5)  # 구독 연결 대기
    for _ in range(5):  # QoS depth 1 volatile — 연결 직후 유실 대비 반복 발행
        pub.publish(Bool(data=True))
        time.sleep(0.1)
    print('\n출발 인가 발행 완료 — 주행 시작!')
    node.destroy_node()
    rclpy.shutdown()


if __name__ == '__main__':
    main()
