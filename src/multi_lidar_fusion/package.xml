<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>multi_lidar_fusion</name>
  <version>0.1.0</version>
  <description>
    2D LiDAR 4대(YDLiDAR T-mini Plus x4)를 하나의 가상 360도
    LiDAR로 추상화하는 융합 노드. 출력은 /lidar/merged_cloud (PointCloud2) 와
    /lidar/merged_scan (LaserScan), 둘 다 base_link 기준.
    회피 로직(stack_avoid)은 /lidar/merged_scan 하나만 구독하면 된다.
  </description>
  <maintainer email="blueheart0815@gmail.com">이기돈</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>

  <!-- 런타임: launch 파일이 띄우는 것들 -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <!-- 센서 드라이버 (multi_lidar_drivers.launch.py 에서만 사용. 융합 코어는 무관) -->
  <exec_depend>ydlidar_ros2_driver</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
