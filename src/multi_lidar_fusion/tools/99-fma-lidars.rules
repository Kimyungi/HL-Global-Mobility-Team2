# FMA four-YDLiDAR fixed vehicle wiring (Xanadu-book5, 2026-09-01).
#
# All four CP2102 units have non-unique identities. The verified physical USB
# hub positions below are therefore the position contract. Do not move cables.
# If the hub or mainboard changes, identify all four physical positions again
# before changing these ID_PATH values.
#
# 설치: sudo cp 99-fma-lidars.rules /etc/udev/rules.d/
#       sudo udevadm control --reload-rules && sudo udevadm trigger

# a1 전방 T-mini Plus — 라이다 전용 허브 포트 1.3
#   /dev/ttyUSB_LIDAR = launch 의 lidar_port 기본값 → 인자를 안 붙여도 전방이 잡힌다
SUBSYSTEM=="tty", ENV{ID_PATH}=="pci-0000:00:14.0-usb-0:1.3:1.0", ATTRS{product}=="CP2102 USB to UART Bridge Controller", MODE:="0666", GROUP:="dialout", SYMLINK+="ttyUSB_LIDAR", SYMLINK+="lidar_front", SYMLINK+="ydlidar"

# a2 후방 T-mini Plus — 라이다 전용 허브 포트 1.2
SUBSYSTEM=="tty", ENV{ID_PATH}=="pci-0000:00:14.0-usb-0:1.2:1.0", ATTRS{product}=="CP2102 USB to UART Bridge Controller", MODE:="0666", GROUP:="dialout", SYMLINK+="lidar_rear"

# b1 좌측 T-mini Plus — 라이다 전용 허브 포트 1.1
SUBSYSTEM=="tty", ENV{ID_PATH}=="pci-0000:00:14.0-usb-0:1.1:1.0", ATTRS{product}=="CP2102 USB to UART Bridge Controller", MODE:="0666", GROUP:="dialout", SYMLINK+="lidar_left"

# b2 우측 T-mini Plus — 라이다 전용 허브 포트 1.4.1
SUBSYSTEM=="tty", ENV{ID_PATH}=="pci-0000:00:14.0-usb-0:1.4.1:1.0", ATTRS{product}=="CP2102 USB to UART Bridge Controller", MODE:="0666", GROUP:="dialout", SYMLINK+="lidar_right"
