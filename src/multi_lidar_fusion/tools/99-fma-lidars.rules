# FMA 라이다 4대 슬롯 고정
#
# ── 2026-09-02 갱신 (새 PC, 4대 전부 YDLiDAR T-mini Plus) ───────────────────
#
# 팀이 PC를 옮기면서(HANDOVER.md) 허브 배치가 예전 값(...usb-0:3.3/3.4)과
# 완전히 달라졌고, 같은 날 RPLiDAR C1M1 2대(b1/b2)도 YDLiDAR T-mini Plus로
# 교체됐다(팀 확인, 의도적). 그래서 아래 두 가지가 예전 규칙과 다르다:
#   ① ID_PATH 네 값을 이 PC에서 다시 실측했다.
#   ② b1/b2도 이제 시리얼이 아니라 ID_PATH로 건다 — T-mini Plus는 USB 서술자
#      레벨 시리얼이 4대 다 "0001"이라 겹친다(SDK 레벨 고유 시리얼은 있지만
#      udev 규칙은 USB 서술자만 본다). RPLiDAR 때 쓰던 ID_SERIAL_SHORT 매칭은
#      이제 안 통한다.
#
# 위치 확정 방법 (이번엔 RViz 4색 오버레이로 손 가림 식별):
#   4대를 /probe/u{0..3}/scan 으로 띄우고 static_transform_publisher 로
#   전부 map 프레임에 얹어 RViz 한 창에서 겹쳐 봤다 — 각 라이다를 손으로
#   가리면 해당 색 점군만 반응하는 걸 보고 위치를 확정했다(2026-09-02).
#   tools/identify_lidar_positions.py 의 "새로 나타난 근접 반사"만 세는 로직은
#   b1(현재 좌측 유닛)처럼 기준선에 이미 근접 반사가 있는 유닛에서 손 가림을
#   과소 카운트하는 경우가 있었다 — 그래서 이번엔 원시 거리값을 직접 봤다.
#
#   ttyUSB2 -> 좌측  (b1)
#   ttyUSB3 -> 후방  (a2)
#   ttyUSB4 -> 전방  (a1)
#   ttyUSB5 -> 우측  (b2)
#
#   ⚠⚠ 2026-09-02, 같은 세션 안에서 재확인: 이 ID_PATH 값이 **몇 시간 만에
#     한 번 바뀌었다** — 라이다 재배선은 없었는데(SDK 시리얼로 물리 유닛↔ttyUSB
#     번호 대응은 그대로였음, 아래 표) 허브 트리 표기(ID_PATH)만 달라졌다.
#     이 PC의 USB 컨트롤러가 재연결/재열거 때 허브 포트 번호를 안정적으로 주지
#     않는 것으로 보인다 — ID_PATH 매칭 자체가 이 PC에서는 근본적으로 불안정할
#     수 있다는 뜻이다. SDK 레벨 시리얼(장비 자체가 갖는 고유 번호, USB 서술자가
#     아니라 YDLiDAR 프로토콜로만 읽힌다)은 그 사이에도 안 바뀌었다:
#       ttyUSB2 serial=2025110300090701 (좌)   ttyUSB3 serial=2026000800070152 (후)
#       ttyUSB4 serial=2026000800070184 (전)   ttyUSB5 serial=2025110300090660 (우)
#     udev 규칙은 USB 서술자만 보므로 이 시리얼로는 못 건다 — 근본적으로 안정적인
#     매핑을 원하면 SDK로 시리얼을 읽어 심링크를 만드는 별도 스크립트/서비스가
#     필요하다(아직 없음, 미해결). 지금은 이 파일을 필요할 때마다 재실측·재설치하는
#     걸로 버틴다.
#
#   재실측 절차:
#     udevadm info -q property -n /dev/ttyUSBx | grep ID_PATH   # 값이 바뀌었는지 확인
#     안 바뀌었으면 아래 ID_PATH 그대로. 바뀌었으면 4대 다 뽑았다 하나씩 꽂아
#     어느 ttyUSB가 나타나는지 보거나, SDK 시리얼로 위 표와 대조해서 재확인.
#
# 설치: sudo cp 99-fma-lidars.rules /etc/udev/rules.d/
#       sudo udevadm control --reload-rules && sudo udevadm trigger

# a1 전방 T-mini Plus (ttyUSB4, serial 2026000800070184)
SUBSYSTEM=="tty", ENV{ID_PATH}=="pci-0000:00:14.0-usb-0:2.3:1.0", ATTRS{product}!="HandsFree IMU*", MODE:="0666", GROUP:="dialout", SYMLINK+="ttyUSB_LIDAR", SYMLINK+="lidar_front", SYMLINK+="ydlidar"

# a2 후방 T-mini Plus (ttyUSB3, serial 2026000800070152)
SUBSYSTEM=="tty", ENV{ID_PATH}=="pci-0000:00:14.0-usb-0:2.2:1.0", ATTRS{product}!="HandsFree IMU*", MODE:="0666", GROUP:="dialout", SYMLINK+="lidar_rear"

# b1 좌측 T-mini Plus (ttyUSB2, serial 2025110300090701 — 2026-09-02부터 RPLiDAR 아님)
SUBSYSTEM=="tty", ENV{ID_PATH}=="pci-0000:00:14.0-usb-0:2.1:1.0", ATTRS{product}!="HandsFree IMU*", MODE:="0666", GROUP:="dialout", SYMLINK+="lidar_left"

# b2 우측 T-mini Plus (ttyUSB5, serial 2025110300090660 — 2026-09-02부터 RPLiDAR 아님)
SUBSYSTEM=="tty", ENV{ID_PATH}=="pci-0000:00:14.0-usb-0:2.4.1:1.0", ATTRS{product}!="HandsFree IMU*", MODE:="0666", GROUP:="dialout", SYMLINK+="lidar_right"
