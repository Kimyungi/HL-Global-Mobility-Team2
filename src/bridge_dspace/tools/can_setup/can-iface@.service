# CAN 인터페이스 자동 셋업 (FMA — PROTOCOL.md: CAN FD, nominal 1 Mbps / data 2 Mbps)
# 어댑터를 꽂으면(부팅 포함) 커널이 장치 유닛을 올리고, 이 서비스가 bitrate 설정 후 up.
# 값은 can_up.sh 와 동일하게 유지할 것 — dSPACE 설정과도 일치해야 한다.
# 설치: install.sh 참조. 수동 확인: systemctl status can-iface@can0
[Unit]
Description=Bring up CAN interface %i as CAN FD 1M/2M (FMA)
BindsTo=sys-subsystem-net-devices-%i.device
After=sys-subsystem-net-devices-%i.device

[Service]
Type=oneshot
RemainAfterExit=yes
# 이미 up이면 비트레이트 변경이 EBUSY로 실패한다 — 먼저 내린다('-' = 실패 무시)
ExecStart=-/usr/sbin/ip link set %i down
# restart-ms 100: bus-off(배선 불량 등) 시 100ms 후 자동 복구
ExecStart=/usr/sbin/ip link set %i type can bitrate 1000000 sample-point 0.8 dbitrate 2000000 dsample-point 0.8 fd on restart-ms 100
ExecStart=/usr/sbin/ip link set %i txqueuelen 100
ExecStart=/usr/sbin/ip link set %i up
ExecStop=/usr/sbin/ip link set %i down

[Install]
WantedBy=sys-subsystem-net-devices-%i.device
