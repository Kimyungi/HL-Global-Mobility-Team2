# systemd-networkd용 can0 설정 (FMA 팀 표준: PROTOCOL.md — CAN FD 1 Mbps / 2 Mbps)
#
# networkd가 활성인 머신에서는 udev(can_up.sh)·can-iface@ 서비스가 올린 설정을
# networkd가 마지막에 덮어쓴다. 실사례(2026-08-03): 초기 실험 잔재였던
# BitRate=500000 파일이 can_up.sh의 1 Mbps를 매 삽입마다 500k로 뒤집어
# ERROR-PASSIVE를 유발했다. 이 파일은 install.sh가 설치하며, 반드시
# PROTOCOL.md의 팀 표준 비트레이트와 일치시킬 것.
#
# ⚠ FDMode=yes 가 빠지면 인터페이스 MTU 가 16 으로 남아 노드가 기동 시
#   "CAN FD 활성화 실패" 로 죽는다 (조용히 classic 으로 떨어지지 않는다 — 의도).
[Match]
Name=can0

[CAN]
BitRate=1000000
SamplePoint=80%
FDMode=yes
DataBitRate=2000000
DataSamplePoint=80%
RestartSec=100ms
