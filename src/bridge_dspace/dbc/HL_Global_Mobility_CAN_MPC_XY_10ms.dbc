VERSION "HL-Global-Mobility-Team2 CAN protocol v3, 51-point MPC XY trajectory at 10 ms"


NS_ :
    NS_DESC_
    CM_
    BA_DEF_
    BA_DEF_DEF_
    BA_
    VAL_
    SIG_VALTYPE_

BS_:

BU_: IndustrialPC dSPACE


BO_ 256 TARGET_HEADER: 8 IndustrialPC
 SG_ counter : 0|16@1+ (1,0) [0|65535] "" dSPACE
 SG_ state : 16|8@1+ (1,0) [0|3] "" dSPACE
 SG_ n_points : 24|8@1+ (1,0) [1|3] "" dSPACE
 SG_ v_ref : 32|16@1- (0.001,0) [-32.767|32.767] "m/s" dSPACE
 SG_ reserved : 48|16@1+ (1,0) [0|65535] "" dSPACE

BO_ 257 REF_POINT_00: 8 IndustrialPC
 SG_ x : 0|16@1- (0.001,0) [-32.767|32.767] "m" dSPACE
 SG_ y : 16|16@1- (0.001,0) [-32.767|32.767] "m" dSPACE
 SG_ yaw : 32|16@1- (0.0001,0) [-3.2767|3.2767] "rad" dSPACE
 SG_ curvature : 48|16@1- (0.0005,0) [-16.3835|16.3835] "1/m" dSPACE

BO_ 258 REF_POINT_01: 8 IndustrialPC
 SG_ x : 0|16@1- (0.001,0) [-32.767|32.767] "m" dSPACE
